{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://16-192-99-209.sslip.io/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
